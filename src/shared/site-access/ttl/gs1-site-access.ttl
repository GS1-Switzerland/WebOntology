    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCode-PPE_REQUIREMENT a sai:AccessRestrictionTypeCode , skos:Concept ;
