    },
    {
      "@id": "gs1:timeZone",
      "@type": "owl:DatatypeProperty",
      "label": {
        "en": "time zone",
        "de": "Zeitzone",
        "fr": "fuseau horaire",
        "it": "fuso orario"
      },
      "comment": {
        "en": "IANA time zone (e.g. Europe/Berlin) in which schema:opens/closes and dates are interpreted. On gs1:SiteAccessInformation (document default) or gs1:AccessTimeWindow (override).",
        "de": "IANA-Zeitzone (z. B. Europe/Berlin), in der schema:opens/closes und Datumsangaben zu lesen sind. An gs1:SiteAccessInformation (Standard für das Dokument) oder gs1:AccessTimeWindow (Überschreibung).",
        "fr": "Fuseau horaire IANA (par ex. Europe/Paris) dans lequel schema:opens/closes et les dates sont interprétés. Sur gs1:SiteAccessInformation (valeur par défaut du document) ou gs1:AccessTimeWindow (remplacement).",
        "it": "Fuso orario IANA (ad es. Europe/Rome) in cui si interpretano schema:opens/closes e le date. Su gs1:SiteAccessInformation (predefinito del documento) o su gs1:AccessTimeWindow (sostituzione)."
      },
      "range": "xsd:string",
      "isDefinedBy": "gs1:module/siteAccess",
      "termStatus": "unstable"
    },
    {
      "@id": "gs1:usedWithLinkType",
      "@type": "owl:AnnotationProperty",
      "label": {
        "en": "used with link type",
        "de": "verwendet mit Linktyp",
        "fr": "utilisé avec le type de lien",
        "it": "usato con il tipo di collegamento"
      },
      "comment": {
        "en": "Annotates a class: the GS1 Digital Link link type(s) under which instances of the class are expected to be published. gs1:siteAccessRequirements exists in the current WebVoc core context; gs1:siteAccessInstructions is the link type named in the requirement - both are listed until the final name is confirmed.",
        "de": "Annotiert eine Klasse: Der GS1-Digital-Link-Linktyp bzw. die Linktypen, unter denen Instanzen dieser Klasse veröffentlicht werden. gs1:siteAccessRequirements existiert im aktuellen WebVoc-Kernkontext; gs1:siteAccessInstructions ist der in der Anforderung genannte Linktyp – beide sind aufgeführt, bis der endgültige Name feststeht.",
        "fr": "Annote une classe : le ou les types de lien GS1 Digital Link sous lesquels les instances de cette classe sont publiées. gs1:siteAccessRequirements existe dans le contexte de base actuel de WebVoc ; gs1:siteAccessInstructions est le type de lien nommé dans l’exigence – les deux sont listés jusqu’à confirmation du nom définitif.",
        "it": "Annota una classe: il/i tipo/i di collegamento GS1 Digital Link con cui si pubblicano le istanze della classe. gs1:siteAccessRequirements esiste nell’attuale contesto di base di WebVoc; gs1:siteAccessInstructions è il tipo di collegamento indicato nel requisito – entrambi sono elencati finché il nome definitivo non è confermato."
      },
      "isDefinedBy": "gs1:module/siteAccess",
      "termStatus": "unstable"
    }
  ]
}
