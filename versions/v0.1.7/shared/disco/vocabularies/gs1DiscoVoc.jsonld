{"@context":["https://ref.gs1.org/standards/epcis/epcis-context.jsonld",{"@version":1.1,"disco":"https://gs1-epcis-reg.org/disco/voc/data#","schema":"https://schema.org/","dc":"http://purl.org/dc/terms/","xsd":"http://www.w3.org/2001/XMLSchema#","voaf":"http://www.w3.org/ns/voaf#","vann":"https://vocab.org/vann/#"}],"@graph":[{"@id":"disco:","@type":["voaf:Vocabulary","owl:Ontology"],"schema:license":"data:text/html;charset=UTF-8,<p>GS1&reg;, under its IP Policy, seeks to avoid uncertainty regarding intellectual property claims by requiring the participants in the Work Groups that developed this vocabulary to agree to grant to GS1 members a royalty-free licence or a RAND licence to Necessary Claims, as that term is defined in the GS1 IP Policy. Furthermore, attention is drawn to the possibility that an implementation of one or more features of this vocabulary may be the subject of a patent or other intellectual property     right that does not involve a Necessary Claim. Any such patent or other intellectual property right is not subject to the licencing obligations of GS1. Moreover, the agreement to grant licences provided under the GS1 IP Policy does not include IP rights and any claims of third parties who were not participants in the Work Groups. Accordingly, GS1 recommends that any organisation developing an implementation designed to be in conformance with this vocabulary should determine whether there are any     patents that may encompass a specific implementation that the organisation is developing in compliance with the vocabulary and whether a licence under a patent or other intellectual property right is needed. Such a determination of a need for licencing should be made in view of the details of the specific system designed by the organisation in consultation with their own patent counsel. THIS DOCUMENT IS PROVIDED &quot;AS IS&quot; WITH NO WARRANTIES WHATSOEVER, INCLUDING ANY WARRANTY OF MERCHANTABILITY, NONINFRINGMENT, FITNESS FOR PARTICULAR PURPOSE, OR ANY WARRANTY OTHER WISE ARISING OUT OF THIS SPECIFICATION. GS1 disclaims all liability for any damages arising from use or misuse of this vocabulary, whether special, indirect, consequential, or compensatory damages, and including liability for infringement of any intellectual property     rights, relating to use of information in or reliance upon this document. GS1 retains the right to make changes to this vocabulary at any time, without notice. GS1 makes no warranty for the use of this vocabulary and assumes no responsibility for any errors which may appear in the vocabulary, nor does it make a commitment to update the     information contained herein. GS1 and the GS1 logo are registered trademarks of GS1 AISBL.</p><p>Copyright 2015-2019 GS1 AISBL</p><p>Licensed under the Apache License, Version 2.0 (the &quot;License&quot;); you may not use this file except in compliance with the License. You may obtain a copy of the License at <a href=&quot;http://www.apache.org/licenses/LICENSE-2.0&quot; target=&quot;blank&quot;>http://www.apache.org/licenses/LICENSE-2.0</a>.<p><p>Unless required by applicable law or agreed to in writing, software distributed under the License is distributed on an &quot;AS IS&quot; BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for the specific language governing permissions and limitations under the License.</p>","dc:contributor":"Dominik Halbeisen, Benjamin Herzig","dc:creator":{"@id":"https://gs1-epcis-reg.org/"},"dc:description":{"@language":"en","@value":"Specific vocabulary for GS1 Discovery Service event information, described using W3C RDF Schema and the Web Ontology Language. The vocabulary builds on and refers to schema.org where appropriate."},"dc:identifier":"GS1 DISCO Vocabulary","dc:title":"GS1 DISCO Vocabulary","dc:issued":{"@type":"xsd:date","@value":"2026-05-04"},"dc:lastModified":{"@type":"xsd:date","@value":"2026-06-04"},"owl:versionInfo":"1.21","vann:preferredNamespacePrefix":"disco","vann:preferredNamespaceUri":{"@id":"disco:"},"voaf:extends":{"@id":"epcis:"}},{"@id":"disco:sectorType","@type":["owl:ObjectProperty","rdf:Property"],"rdfs:comment":{"@language":"en","@value":"Describes the industry domain, to which the event belongs."},"rdfs:domain":"epcis:EPCISEvent","rdfs:isDefinedBy":"disco:","rdfs:label":"Sector Type","rdfs:range":"disco:SectorType","sw:term_status":"stable"},{"@id":"disco:SectorType","@type":["owl:Class","rdfs:Class"],"rdfs:label":"Types of Sector events","rdfs:domain":{"@id":"epcis:EPCISEvent"},"rdfs:comment":{"@language":"en","@value":"A class regrouping different types of sectors, from which a given event originates."}},{"@id":"disco:WTMS","@type":"disco:SectorType","rdfs:label":"WTMS Event","rdfs:comment":{"@language":"en","@value":"Describes an event, which comes from Wayside Train Monitoring Systems in the rail sector."},"rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:GENERAL","@type":"disco:SectorType","rdfs:label":"General Event","rdfs:comment":{"@language":"en","@value":"Describes an event, which does not come from a specific sector."},"rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:DEFN","@type":"disco:SectorType","rdfs:label":"Defence Event","rdfs:comment":{"@language":"en","@value":"Describes an event, which comes from the defence sector."},"rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:VisibilityStatus","@type":["owl:Class","rdfs:Class"],"rdfs:label":"Visibility Status","rdfs:domain":{"@id":"owl:Thing"},"rdfs:comment":{"@language":"en","@value":"A class regrouping different status groups of visibility for data points"}},{"@id":"disco:visibility","@type":["owl:ObjectProperty","rdf:Property"],"rdfs:label":"Visibility of sensor data","rdfs:comment":{"@language":"en","@value":"Indicates whether the respective sensor data can be accessed publicly or only based on defined access rights by the information owner"},"rdfs:range":{"@id":"disco:VisibilityStatus"},"rdfs:domain":{"@id":"epcis:SensorMetadata"},"rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:purpose","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"Purpose of a link","rdfs:comment":{"@language":"en","@value":"Indicates the purpose of a link presented"},"rdfs:domain":{"@id":"owl:Thing"},"rdfs:range":"xsd:string","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:restricted","@type":"disco:VisibilityStatus","rdfs:label":"Restricted","rdfs:comment":{"@language":"en","@value":"Indicates that a given object can only be seen with permissions granted by the information owner"},"rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:public","@type":"disco:VisibilityStatus","rdfs:label":"Public","rdfs:comment":{"@language":"en","@value":"Indicates that a given object is public and can be seen without any permissions granted by the information owner"},"rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:DataProcessingMethod","@type":["owl:Class","rdfs:Class"],"rdfs:label":"Data Processing Method","rdfs:domain":{"@id":"epcis:SensorMetadata"},"rdfs:comment":{"@language":"en","@value":"A class regrouping methods used to process sensor data"}},{"@id":"disco:dataProcessingMethodType","@type":["owl:ObjectProperty","rdf:Property"],"rdfs:label":"Type of Data Processing Method","rdfs:comment":{"@language":"en","@value":"A method used to process sensor data, e.g., filtering, averaging, or setting nominal values."},"rdfs:range":{"@id":"disco:DataProcessingMethod"},"rdfs:domain":{"@id":"epcis:SensorMetadata"},"rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:registryEntries","@type":["owl:ObjectProperty","rdf:Property"],"rdfs:label":"Registry entries","rdfs:comment":{"@language":"en","@value":"Links an object or identifier to one or more service endpoints providing downloadable EPCIS-related resources."},"rdfs:range":{"@id":"schema:Service"},"rdfs:isDefinedBy":"disco:","rdfs:domain":{"@id":"schema:Thing"},"sw:term_status":"stable"},{"@id":"disco:Authentication","@type":["owl:Class","rdf:Class"],"rdfs:label":"Authentication Class","rdfs:comment":{"@language":"en","@value":"Authentication information required to access a service target, such as API key headers."},"rdfs:isDefinedBy":"disco:","rdfs:domain":{"@id":"schema:WebAPI"},"sw:term_status":"stable"},{"@id":"disco:auth","@type":["owl:ObjectProperty","rdf:Property"],"rdfs:label":"authentication","rdfs:comment":{"@language":"en","@value":"Links a target endpoint (EntryPoint) to the authentication object required to access it."},"rdfs:domain":{"@id":"schema:EntryPoint"},"schema:rangeIncludes":{"@id":"disco:Authentication"},"rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:apiKey","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"API Key","rdfs:comment":{"@language":"en","@value":"The API key used for authenticating access to an endpoint."},"rdfs:domain":{"@id":"disco:Authentication"},"rdfs:range":"xsd:string","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:apiKeyHeader","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"API Key Header","rdfs:comment":{"@language":"en","@value":"The HTTP header used to send the API key when accessing an endpoint."},"rdfs:domain":{"@id":"disco:Authentication"},"rdfs:range":"xsd:string","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:resultsOverview","@type":["owl:ObjectProperty","rdf:Property"],"rdfs:comment":{"@language":"en","@value":"An element containing one or several attributes that pertain to a specific query for events in regards to a given object / thing"},"rdfs:isDefinedBy":"disco:","rdfs:domain":{"@id":"schema:Thing"},"schema:rangeIncludes":{"@id":"disco:ResultsOverviewAttributes"},"rdfs:label":"Query results overview","sw:term_status":"stable"},{"@id":"disco:ResultsOverviewAttributes","@type":["owl:Class","rdf:Class"],"rdfs:comment":{"@language":"en","@value":"A set of attributes describing the number of events registered in regards to a given object / thing"},"rdfs:isDefinedBy":"disco:","rdfs:domain":{"@id":"schema:Thing"},"rdfs:label":"Query result overview attributes","sw:term_status":"stable"},{"@id":"disco:VerifiedByGS1Attributes","@type":["owl:Class","rdf:Class"],"rdfs:comment":{"@language":"en","@value":"A set of attributes describing attributes returned by Verified by GS1 in regards to a given object / thing"},"rdfs:isDefinedBy":"disco:","rdfs:domain":{"@id":"schema:Thing"},"rdfs:label":"VbG query result overview attributes","sw:term_status":"stable"},{"@id":"disco:totalEventCount","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"Number of total events","rdfs:comment":{"@language":"en","@value":"Returns the number of all events known in regards to an object / thing."},"rdfs:domain":{"@id":"disco:ResultsOverviewAttributes"},"rdfs:range":"xsd:integer","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:returnedEventCount","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"Number of shown events","rdfs:comment":{"@language":"en","@value":"Returns the number of events, that can be shown in the query response message in regards to an object / thing."},"rdfs:domain":{"@id":"disco:ResultsOverviewAttributes"},"rdfs:range":"xsd:integer","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:restrictedEventCount","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"Number of restricted events","rdfs:comment":{"@language":"en","@value":"Returns the number of events, that can NOT be shown in the query response message in regards to an object / thing."},"rdfs:domain":{"@id":"rdisco:ResultsOverviewAttributes"},"rdfs:range":"xsd:integer","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:authorizationRequestEndpoint","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"Authorization request endpoints","rdfs:comment":{"@language":"en","@value":"A list of URL endpoints that can be used to request access to restricted event data. Multiple endpoints may be provided."},"rdfs:domain":{"@id":"disco:ResultsOverviewAttributes"},"rdfs:range":"xsd:anyURI","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:restrictionReason","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"Reason for event restriction","rdfs:comment":{"@language":"en","@value":"Returns the reason why certain events could not be shown are only listed as restricted"},"rdfs:domain":{"@id":"disco:ResultsOverviewAttributes"},"rdfs:range":"xsd:string","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:licenceKey","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"Global Company Prefix of a GS1 member","rdfs:comment":{"@language":"en","@value":"Shows the licence key found in Verified by GS1 in regards to the identifier of an object / thing."},"rdfs:domain":{"@id":"disco:VerifiedByGS1Attributes"},"rdfs:range":"xsd:integer","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:licenseeName","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"Name of the GS1 member","rdfs:comment":{"@language":"en","@value":"Shows the name of the company behind the licence key found in Verified by GS1 in regards to the identifier of an object / thing."},"rdfs:domain":{"@id":"disco:VerifiedByGS1Attributes"},"rdfs:range":"xsd:string","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:keyRecordStatus","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"Status of a VbG record","rdfs:comment":{"@language":"en","@value":"Shows the status of a VbG record"},"rdfs:domain":{"@id":"disco:VerifiedByGS1Attributes"},"rdfs:range":"xsd:string","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"},{"@id":"disco:vbgmessage","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"VbG query message","rdfs:comment":{"@language":"en","@value":"Text message returned by Verified by GS1"},"rdfs:domain":{"@id":"disco:VerifiedByGS1Attributes"},"rdfs:range":"xsd:string","rdfs:isDefinedBy":"disco:","sw:term_status":"stable"}]}