{"@context":["https://schema.org/version/latest/schemaorg-current-https.jsonld",{"@version":1.1,"schema":"https://schema.org/","epcis":"https://ref.gs1.org/epcis/","bo":"https://gs1-epcis-reg.org/ind/#"}],"@id":"https://gs1-epcis-reg.org/ind/bearingOntology","@type":"owl:Ontology","owl:versionInfo":"3.5","rdfs:label":{"@language":"en","@value":"Bearing Ontology for EPCIS"},"rdfs:comment":{"@language":"en","@value":"An OWL ontology defining rolling bearing types and measurement vocabulary for use in GS1 EPCIS 2.0 events. Bearing type terminology is aligned with ISO 5593:2023. Product identity is expressed at the instance level via GS1 Digital Link URIs. Component-to-bearing associations, including rolling element quantities, are recorded via EPCIS AssociationEvents, not in this ontology."},"@graph":[{"@id":"bo:MachineElement","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Machine Element"},"rdfs:subClassOf":{"@id":"owl:Thing"},"rdfs:comment":{"@language":"en","@value":"An elementary component of a machine. (ISO 5593:2023 scope)"}},{"@id":"bo:BearingComponent","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Bearing Component"},"rdfs:subClassOf":{"@id":"bo:MachineElement"},"rdfs:comment":{"@language":"en","@value":"A constituent part of a bearing assembly, e.g. inner ring, outer ring, rolling element, cage, seal. Associations between components and a bearing assembly, including rolling element quantities per row, are recorded via EPCIS AssociationEvents. Whether a component is also a schema:Product is asserted at the instance level only."}},{"@id":"bo:InnerRing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Inner Ring"},"rdfs:subClassOf":{"@id":"bo:BearingComponent"},"rdfs:comment":{"@language":"en","@value":"The inner ring of a rolling bearing. (ISO 5593:2023)"}},{"@id":"bo:OuterRing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Outer Ring"},"rdfs:subClassOf":{"@id":"bo:BearingComponent"},"rdfs:comment":{"@language":"en","@value":"The outer ring of a rolling bearing. (ISO 5593:2023)"}},{"@id":"bo:RollingElement","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Rolling Element"},"rdfs:subClassOf":{"@id":"bo:BearingComponent"},"rdfs:comment":{"@language":"en","@value":"An individual rolling body — ball, cylindrical roller, tapered roller, spherical roller, or needle roller — defined by its geometry and material. May carry its own GTIN. The quantity installed per bearing row is not a property of this class; it is expressed via the quantityList of an EPCIS AssociationEvent. (ISO 5593:2023)"}},{"@id":"bo:Cage","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Cage"},"rdfs:subClassOf":{"@id":"bo:BearingComponent"},"rdfs:comment":{"@language":"en","@value":"A bearing part that partially surrounds the rolling elements and moves with them, used to space them and/or guide them. (ISO 5593:2023)"}},{"@id":"bo:Seal","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Seal"},"rdfs:subClassOf":{"@id":"bo:BearingComponent"},"rdfs:comment":{"@language":"en","@value":"A device attached to or forming part of a bearing to retain lubricant and/or exclude contaminants. (ISO 5593:2023)"}},{"@id":"bo:Bearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Bearing"},"rdfs:subClassOf":{"@id":"bo:MachineElement"},"rdfs:comment":{"@language":"en","@value":"A machine element that constrains relative motion and reduces friction between moving parts. (ISO 5593:2023). Whether a specific bearing is also a schema:Product is asserted at the instance level via its GTIN."}},{"@id":"bo:RollingBearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Rolling Bearing"},"rdfs:subClassOf":{"@id":"bo:Bearing"},"rdfs:comment":{"@language":"en","@value":"A bearing that carries load by placing rolling elements between concentric rings providing rolling surfaces called raceways. (ISO 5593:2023)"}},{"@id":"bo:BallBearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Ball Bearing"},"rdfs:subClassOf":{"@id":"bo:RollingBearing"},"rdfs:comment":{"@language":"en","@value":"A rolling bearing in which the rolling elements are balls, providing point contact with the raceways. (ISO 5593:2023)"}},{"@id":"bo:DeepGrooveBallBearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Deep Groove Ball Bearing"},"rdfs:subClassOf":{"@id":"bo:BallBearing"},"skos:altLabel":{"@language":"en","@value":"DGBB"},"rdfs:comment":{"@language":"en","@value":"A ball bearing with deep continuous grooved raceways, capable of supporting radial and axial loads in both directions. (ISO 5593:2023)"}},{"@id":"bo:AngularContactBallBearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Angular Contact Ball Bearing"},"rdfs:subClassOf":{"@id":"bo:BallBearing"},"skos:altLabel":{"@language":"en","@value":"ACBB"},"rdfs:comment":{"@language":"en","@value":"A ball bearing designed to accommodate combined radial and axial loads, with inner and outer raceways displaced relative to each other in the bearing axis direction. (ISO 5593:2023)"}},{"@id":"bo:SelfAligningBallBearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Self-Aligning Ball Bearing"},"rdfs:subClassOf":{"@id":"bo:BallBearing"},"rdfs:comment":{"@language":"en","@value":"A double-row ball bearing with a common spherical outer ring raceway, allowing compensation of shaft misalignment or mounting errors. (ISO 5593:2023)"}},{"@id":"bo:FourPointContactBallBearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Four-Point Contact Ball Bearing"},"rdfs:subClassOf":{"@id":"bo:BallBearing"},"rdfs:comment":{"@language":"en","@value":"A single-row angular contact ball bearing in which each ball makes contact at four points, enabling high axial load capacity in both directions. (ISO 5593:2023)"}},{"@id":"bo:RollerBearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Roller Bearing"},"rdfs:subClassOf":{"@id":"bo:RollingBearing"},"rdfs:comment":{"@language":"en","@value":"A rolling bearing in which the rolling elements are rollers, providing line contact with the raceways. (ISO 5593:2023)"}},{"@id":"bo:CylindricalRollerBearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Cylindrical Roller Bearing"},"rdfs:subClassOf":{"@id":"bo:RollerBearing"},"skos:altLabel":{"@language":"en","@value":"CRB"},"rdfs:comment":{"@language":"en","@value":"A roller bearing with cylindrical rollers, offering high radial load capacity and low friction. (ISO 5593:2023)"}},{"@id":"bo:TaperedRollerBearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Tapered Roller Bearing"},"rdfs:subClassOf":{"@id":"bo:RollerBearing"},"skos:altLabel":{"@language":"en","@value":"TRB"},"rdfs:comment":{"@language":"en","@value":"A roller bearing with tapered rollers and raceways, capable of carrying combined radial and axial loads. (ISO 5593:2023)"}},{"@id":"bo:SphericalRollerBearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Spherical Roller Bearing"},"rdfs:subClassOf":{"@id":"bo:RollerBearing"},"skos:altLabel":{"@language":"en","@value":"SRB"},"rdfs:comment":{"@language":"en","@value":"A double-row roller bearing with barrel-shaped rollers and a spherical outer ring raceway, providing self-alignment capability. (ISO 5593:2023)"}},{"@id":"bo:NeedleRollerBearing","@type":"owl:Class","rdfs:label":{"@language":"en","@value":"Needle Roller Bearing"},"rdfs:subClassOf":{"@id":"bo:RollerBearing"},"rdfs:comment":{"@language":"en","@value":"A roller bearing with rollers whose length is at least four times their diameter, suited for high radial loads in compact cross-sections. (ISO 5593:2023)"}},{"@id":"bo:axialInternalClearance","@type":"gs1:MeasurementType","rdfs:label":{"@language":"en","@value":"Axial Internal Clearance"},"rdfs:isDefinedBy":{"@id":"bo:"},"rdfs:comment":{"@language":"en","@value":"Arithmetic mean of axial distances through which one ring may be displaced relative to the other, from one axial extreme to the opposite extreme, under zero external load. (ISO 5753-1)"}},{"@id":"bo:radialInternalClearance","@type":"gs1:MeasurementType","rdfs:label":{"@language":"en","@value":"Radial Internal Clearance"},"rdfs:isDefinedBy":{"@id":"bo:"},"rdfs:comment":{"@language":"en","@value":"Arithmetic mean of radial distances through which one ring may be displaced relative to the other, from one eccentric extreme to the diametrically opposite extreme, under zero external load. (ISO 5753-1)"}},{"@id":"bo:outerDiameter","@type":"gs1:MeasurementType","rdfs:label":{"@language":"en","@value":"Outer Diameter"},"rdfs:isDefinedBy":{"@id":"bo:"},"rdfs:comment":{"@language":"en","@value":"Outside diameter of the bearing outer ring. (ISO 492)"}},{"@id":"bo:boreDiameter","@type":"gs1:MeasurementType","rdfs:label":{"@language":"en","@value":"Bore Diameter"},"rdfs:isDefinedBy":{"@id":"bo:"},"rdfs:comment":{"@language":"en","@value":"Bore diameter of the bearing inner ring. For bearings with multiple inner rings, each ring must be identified via its own serialized EPC; measurement without serialization is applicable only as a class-level nominal value. (ISO 492)"}},{"@id":"bo:greaseFill","@type":"gs1:MeasurementType","rdfs:label":{"@language":"en","@value":"Grease Fill"},"rdfs:isDefinedBy":{"@id":"bo:"},"rdfs:comment":{"@language":"en","@value":"Mass of grease filled into a bearing during manufacturing or refurbishment. Recommended unit of measure: GRM (grams, UN/CEFACT Rec 20)."}},{"@id":"bo:reference","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":{"@language":"en","@value":"Reference to Standard Source"},"rdfs:isDefinedBy":{"@id":"bo:"},"rdfs:domain":{"@id":"epcis:SensorReport"},"rdfs:range":{"@id":"xsd:anyURI"},"rdfs:comment":{"@language":"en","@value":"URI or well-known identifier of the normative standard under which the measurement was performed, e.g. 'https://www.iso.org/standard/45477.html' for ISO 492. Must be a resolvable or publicly registered identifier; internal conventions SHOULD NOT be used."}},{"@id":"bo:measurementCodeAsPerReference","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":{"@language":"en","@value":"Measurement Code"},"rdfs:isDefinedBy":{"@id":"bo:"},"rdfs:domain":{"@id":"epcis:SensorReport"},"rdfs:range":{"@id":"xsd:string"},"rdfs:comment":{"@language":"en","@value":"A code identifying the specific measurement position or procedure as defined within the standard referenced by bo:reference. Only normatively defined codes from published standards are valid values. For component-specific measurements on multi-ring assemblies, serialization of the individual component is required instead."}}]}
