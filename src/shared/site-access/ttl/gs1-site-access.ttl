    rdfs:comment "Health, hygiene or clothing rules."@en ;
    skos:inScheme sai:AccessRestrictionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCode-NO_IDLING_RESTRICTION a sai:AccessRestrictionTypeCode , skos:Concept ;
    rdfs:label "No Idling Restriction"@en ;
    rdfs:comment "Engines off while waiting or unloading."@en ;
    skos:inScheme sai:AccessRestrictionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
