    },
    {
      "@id": "sai:addressedTo",
      "@type": "owl:ObjectProperty",
      "label": {
        "en": "addressed to",
        "de": "gerichtet an",
        "fr": "destiné à",
        "it": "rivolto a"
      },
      "comment": {
        "en": "Role(s) for which a statement is relevant. Use on any sai:SiteAccessElement, on a gs1:Place used as access point, or on a gs1:ContactPoint. Absence means sai:SiteAccessRoleCode-ANY.",
        "de": "Rolle(n), für die eine Aussage relevant ist. Verwendbar an jedem sai:SiteAccessElement, an einem als Zugangspunkt genutzten gs1:Place oder an einem gs1:ContactPoint. Fehlt die Angabe, gilt sai:SiteAccessRoleCode-ANY.",
        "fr": "Rôle(s) pour lesquels un énoncé est pertinent. Utilisable sur tout sai:SiteAccessElement, sur un gs1:Place servant de point d’accès ou sur un gs1:ContactPoint. En l’absence, sai:SiteAccessRoleCode-ANY s’applique.",
        "it": "Ruolo/i per cui un’affermazione è rilevante. Utilizzabile su ogni sai:SiteAccessElement, su un gs1:Place usato come punto di accesso o su un gs1:ContactPoint. Se assente, vale sai:SiteAccessRoleCode-ANY."
      },
      "range": "sai:SiteAccessRoleCode",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:advanceNotice",
      "@type": "owl:DatatypeProperty",
      "label": {
        "en": "advance notice",
        "de": "Vorlaufzeit",
        "fr": "préavis",
        "it": "preavviso"
      },
      "comment": {
        "en": "Minimum lead time before arrival, ISO 8601 (PT24H).",
        "de": "Mindestvorlauf vor der Ankunft, ISO 8601 (PT24H).",
        "fr": "Délai minimal avant l’arrivée, ISO 8601 (PT24H).",
        "it": "Anticipo minimo rispetto all’arrivo, ISO 8601 (PT24H)."
      },
      "domain": "sai:RegistrationRequirement",
      "range": "xsd:duration",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:applicableVehicleType",
      "@type": "owl:ObjectProperty",
      "label": {
        "en": "applicable vehicle type",
        "de": "gilt für Fahrzeugart",
        "fr": "s’applique au type de véhicule",
        "it": "si applica al tipo di veicolo"
      },
      "comment": {
        "en": "Vehicle type(s) for which the statement is relevant.",
        "de": "Fahrzeugart(en), für die die Aussage relevant ist.",
        "fr": "Type(s) de véhicule pour lesquels l’énoncé est pertinent.",
        "it": "Tipo/i di veicolo per cui l’affermazione è rilevante."
      },
      "range": "sai:VehicleTypeCode",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:appliesToAccessPoint",
      "@type": "owl:ObjectProperty",
      "label": {
        "en": "applies to access point",
        "de": "gilt für Zugangspunkt",
        "fr": "s’applique au point d’accès",
        "it": "si applica al punto di accesso"
      },
      "comment": {
        "en": "Restricts the statement to a specific access point (a gs1:Place). Absence means the whole site.",
        "de": "Beschränkt die Aussage auf einen bestimmten Zugangspunkt (einen gs1:Place). Fehlt die Angabe, gilt sie für den gesamten Standort.",
        "fr": "Limite l’énoncé à un point d’accès précis (un gs1:Place). En l’absence, il vaut pour tout le site.",
        "it": "Limita l’affermazione a un punto di accesso specifico (un gs1:Place). Se assente, vale per l’intero sito."
      },
      "range": "gs1:Place",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:appliesToGoodsType",
      "@type": "owl:ObjectProperty",
      "label": {
        "en": "applies to goods type",
        "de": "gilt für Warenart",
        "fr": "s’applique au type de marchandise",
        "it": "si applica al tipo di merce"
      },
      "comment": {
        "en": "Restricts the statement to a kind of goods, e.g. parcels accepted only until 12:00.",
        "de": "Beschränkt die Aussage auf eine Warenart, z. B. Pakete werden nur bis 12:00 Uhr angenommen.",
        "fr": "Limite l’énoncé à un type de marchandise, par ex. colis acceptés uniquement jusqu’à 12 h.",
        "it": "Limita l’affermazione a un tipo di merce, ad es. pacchi accettati solo fino alle 12:00."
      },
      "range": "sai:GoodsTypeCode",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:arrivalTolerance",
      "@type": "owl:DatatypeProperty",
      "label": {
        "en": "arrival tolerance",
        "de": "Ankunftstoleranz",
        "fr": "tolérance d’arrivée",
        "it": "tolleranza di arrivo"
      },
      "comment": {
        "en": "Accepted deviation from slot start, ISO 8601 (PT15M).",
        "de": "Zulässige Abweichung vom Slotbeginn, ISO 8601 (PT15M).",
        "fr": "Écart admis par rapport au début du créneau, ISO 8601 (PT15M).",
        "it": "Scostamento ammesso rispetto all’inizio dello slot, ISO 8601 (PT15M)."
      },
      "domain": "sai:AccessTimeWindow",
      "range": "xsd:duration",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:basedOn",
      "@type": "owl:ObjectProperty",
      "label": {
        "en": "based on",
        "de": "basiert auf",
        "fr": "basé sur",
        "it": "basato su"
      },
      "comment": {
        "en": "Company-wide default document this site document builds on. Categories the site document leaves empty are taken from the base document.",
        "de": "Unternehmensweites Standarddokument, auf dem dieses Standortdokument aufbaut. Kategorien, die das Standortdokument leer lässt, werden aus dem Basisdokument übernommen.",
        "fr": "Document par défaut de l’entreprise sur lequel s’appuie ce document de site. Les catégories laissées vides par le document du site sont reprises du document de base.",
        "it": "Documento predefinito aziendale su cui si basa questo documento del sito. Le categorie lasciate vuote dal documento del sito sono prese dal documento di base."
      },
      "domain": "sai:SiteAccessInformation",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:buildingName",
      "@type": "owl:DatatypeProperty",
      "label": {
        "en": "building name",
        "de": "Gebäudename",
        "fr": "nom du bâtiment",
        "it": "nome dell’edificio"
      },
      "comment": {
        "en": "Name or number of the building (for multi-building sites and business parks).",
        "de": "Name oder Nummer des Gebäudes (bei Geländen mit mehreren Gebäuden und Gewerbeparks).",
        "fr": "Nom ou numéro du bâtiment (sites à plusieurs bâtiments, parcs d’activités).",
        "it": "Nome o numero dell’edificio (siti con più edifici, parchi industriali)."
      },
      "domain": "gs1:Place",
      "range": "rdfs:Literal",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:closureReason",
      "@type": "owl:ObjectProperty",
      "label": {
        "en": "closure reason",
        "de": "Schließgrund",
        "fr": "motif de fermeture",
        "it": "motivo della chiusura"
      },
      "comment": {
        "en": "Why the site or goods-in is closed in this window.",
        "de": "Warum der Standort oder der Wareneingang in diesem Zeitfenster geschlossen ist.",
        "fr": "Pourquoi le site ou la réception des marchandises est fermé pendant cette plage.",
        "it": "Perché il sito o il ricevimento merci è chiuso in questa fascia."
      },
      "domain": "sai:AccessTimeWindow",
      "range": "sai:ClosureReasonCode",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:contactPriority",
      "@type": "owl:DatatypeProperty",
      "label": {
        "en": "contact priority",
        "de": "Kontaktpriorität",
        "fr": "priorité du contact",
        "it": "priorità del contatto"
      },
      "comment": {
        "en": "Order in which to try contacts for the same situation; 1 = first.",
        "de": "Reihenfolge, in der Kontakte für dieselbe Situation versucht werden; 1 = zuerst.",
        "fr": "Ordre dans lequel essayer les contacts pour la même situation ; 1 = en premier.",
        "it": "Ordine in cui provare i contatti per la stessa situazione; 1 = per primo."
      },
      "domain": "gs1:ContactPoint",
      "range": "xsd:positiveInteger",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:describesSite",
      "@type": "owl:ObjectProperty",
      "label": {
        "en": "describes site",
        "de": "beschreibt Standort",
        "fr": "décrit le site",
        "it": "descrive il sito"
      },
      "comment": {
        "en": "The site (a gs1:Place, typically with a GLN) described by the document. If WebVoc gs1:location is confirmed to fit this domain it can replace this term.",
        "de": "Der im Dokument beschriebene Standort (ein gs1:Place, in der Regel mit GLN). Falls sich gs1:location für diese Domäne als passend erweist, kann es diesen Begriff ersetzen.",
        "fr": "Le site (un gs1:Place, généralement avec un GLN) décrit par le document. Si gs1:location s’avère adapté à ce domaine, il peut remplacer ce terme.",
        "it": "Il sito (un gs1:Place, di norma con GLN) descritto dal documento. Se gs1:location risulta adatto a questo dominio, può sostituire questo termine."
      },
      "domain": "sai:SiteAccessInformation",
      "range": "gs1:Place",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:floorLevel",
      "@type": "owl:DatatypeProperty",
      "label": {
        "en": "floor level",
        "de": "Etage",
        "fr": "étage",
        "it": "piano"
      },
      "comment": {
        "en": "Floor or level as shown in the building, e.g. 3, EG, -1.",
        "de": "Stockwerk wie im Gebäude beschriftet, z. B. 3, EG, -1.",
        "fr": "Étage tel qu’indiqué dans le bâtiment, par ex. 3, RDC, -1.",
        "it": "Piano come indicato nell’edificio, ad es. 3, PT, -1."
      },
      "domain": "gs1:Place",
      "range": "xsd:string",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:glnExtension",
      "@type": "owl:DatatypeProperty",
      "label": {
        "en": "gln extension",
        "de": "GLN-Erweiterung",
        "fr": "extension GLN",
        "it": "estensione GLN"
      },
      "comment": {
        "en": "GLN extension component (GS1 Application Identifier 254): up to 20 characters that identify a sub-location (dock door, floor, room, bay) together with the GLN of the site, or of the building above it, that carries the extension. GS1 Digital Link form: /414/{GLN}/254/{extension}. Extension plus GLN identify the place; the extension alone does not.",
        "de": "GLN-Erweiterungskomponente (GS1-Anwendungskennung 254): bis zu 20 Zeichen, die zusammen mit der GLN des Standorts oder des darüberliegenden Gebäudes, das die Erweiterung trägt, einen Unterstandort (Rampentor, Etage, Raum, Stellplatz) identifizieren. GS1-Digital-Link-Form: /414/{GLN}/254/{Erweiterung}. Erst Erweiterung plus GLN identifizieren den Ort; die Erweiterung allein nicht.",
        "fr": "Composante d’extension GLN (identifiant d’application GS1 254) : jusqu’à 20 caractères qui identifient un sous-emplacement (porte de quai, étage, pièce, emplacement) avec la GLN du site, ou du bâtiment supérieur qui porte l’extension. Forme GS1 Digital Link : /414/{GLN}/254/{extension}. C’est l’extension avec la GLN qui identifie le lieu ; l’extension seule ne le fait pas.",
        "it": "Componente di estensione GLN (identificatore di applicazione GS1 254): fino a 20 caratteri che, insieme alla GLN del sito o dell’edificio sovrastante che porta l’estensione, identificano una sotto-ubicazione (porta di banchina, piano, stanza, posto). Forma GS1 Digital Link: /414/{GLN}/254/{estensione}. Identificano il luogo l’estensione e la GLN insieme; l’estensione da sola no."
      },
      "domain": "gs1:Place",
      "range": "xsd:string",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
