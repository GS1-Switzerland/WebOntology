sai:SiteInstructionTypeCode-LOADING_PROCEDURE a sai:SiteInstructionTypeCode , skos:Concept ;
    rdfs:label "Loading Procedure"@en ;
    rdfs:comment "Collecting and loading outbound goods."@en ;
    skos:inScheme sai:SiteInstructionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
