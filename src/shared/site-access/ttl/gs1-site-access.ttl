    skos:inScheme sai:AccessRestrictionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCode-MOBILE_DEVICE_RESTRICTION a sai:AccessRestrictionTypeCode , skos:Concept ;
    rdfs:label "Mobile Device Restriction"@en ;
    rdfs:comment "Phone or device restrictions."@en ;
    skos:inScheme sai:AccessRestrictionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCode-HAZARDOUS_GOODS_RESTRICTION a sai:AccessRestrictionTypeCode , skos:Concept ;
    rdfs:label "Hazardous Goods Restriction"@en ;
    rdfs:comment "Dangerous goods restrictions, e.g. ADR."@en ;
    skos:inScheme sai:AccessRestrictionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCode-AGE_RESTRICTION a sai:AccessRestrictionTypeCode , skos:Concept ;
    rdfs:label "Age Restriction"@en ;
    rdfs:comment "Minimum age."@en ;
    skos:inScheme sai:AccessRestrictionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCode-HYGIENE_REQUIREMENT a sai:AccessRestrictionTypeCode , skos:Concept ;
