    skos:inScheme sai:AccessRestrictionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCode-PACKAGE_WEIGHT_LIMIT a sai:AccessRestrictionTypeCode , skos:Concept ;
    rdfs:label "Package Weight Limit"@en ;
    rdfs:comment "Maximum weight of one package for manual handling; heavier items need equipment or a second person."@en ;
    skos:inScheme sai:AccessRestrictionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCode-OTHER_RESTRICTION a sai:AccessRestrictionTypeCode , skos:Concept ;
