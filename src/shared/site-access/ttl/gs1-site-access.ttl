    rdfs:comment "Not covered by another member; explain in restrictionText."@en ;
    skos:inScheme sai:AccessRestrictionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionModeCode a owl:Class ;
    rdfs:label "Access Restriction Mode Code"@en ;
    rdfs:comment "How a restriction operates. Code list in WebVoc style: members are sai:AccessRestrictionModeCode-MEMBER_NAME and skos:Concepts."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionModeCodeScheme a skos:ConceptScheme ;
