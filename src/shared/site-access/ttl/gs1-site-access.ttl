sai:SiteInstructionTypeCode-UNLOADING_PROCEDURE a sai:SiteInstructionTypeCode , skos:Concept ;
    rdfs:label "Unloading Procedure"@en ;
    rdfs:comment "Presenting and unloading inbound goods."@en ;
