{"@context":["https://ref.gs1.org/standards/epcis/epcis-context.jsonld",{"@version":1.1,"rail":"https://gs1-epcis-reg.org/rail/voc/data#","disco":"https://gs1-epcis-reg.org/disco/voc/data#","schema":"https://schema.org/","dc":"http://purl.org/dc/terms/","xsd":"http://www.w3.org/2001/XMLSchema#","voaf":"http://www.w3.org/ns/voaf#","vann":"https://vocab.org/vann/#"}],"@graph":[{"@id":"rail:","@type":["voaf:Vocabulary","owl:Ontology"],"schema:license":"data:text/html;charset=UTF-8,<p>license text omitted in fixture</p>","dc:contributor":"Dominik Halbeisen, Benjamin Herzig, Elio Hbeich","dc:creator":{"@id":"https://gs1-epcis-reg.org/"},"dc:description":{"@language":"en","@value":"The GS1 Rail vocabulary, described using W3C RDF Schema and the Web Ontology Language. The vocabulary builds on and refers to schema.org where appropriate."},"dc:identifier":"GS1 Rail Vocabulary","dc:title":"GS1 Rail Vocabulary","dc:issued":{"@type":"xsd:date","@value":"2025-10-23"},"dc:lastModified":{"@type":"xsd:date","@value":"2026-07-13"},"owl:versionInfo":"2.2","vann:preferredNamespacePrefix":"rail","vann:preferredNamespaceUri":{"@id":"rail:"},"voaf:extends":{"@id":"epcis:"}},{"@id":"rail:europeanTrackLocation","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"European Track Location","rdfs:domain":{"@id":"gs1:Place"},"rdfs:range":"xsd:string","rdfs:comment":{"@language":"en","@value":"Represents a location label / human readable context submitted by the data provider indicating the location associated with a rail asset or event."},"sw:term_status":"stable"},{"@id":"rail:geo","@type":["owl:DatatypeProperty","rdf:Property"],"rdfs:label":"Geo coordinates, Lat, Long","rdfs:domain":{"@id":"gs1:Place"},"rdfs:range":"xsd:string","rdfs:comment":{"@language":"en","@value":"A geographic location described by its geo-coordinates in a string latitude,longitude, separated by a comma."},"rdfs:seeAlso":[{"@id":"gs1:geo"},{"@id":"gs1:GeoCoordinates"},{"@id":"gs1:latitude"},{"@id":"gs1:longitude"}],"sw:term_status":"stable"},{"@id":"rail:NominalValueSet","@type":["owl:Class","rdfs:Class"],"rdfs:label":"Nominal Value Set","rdfs:domain":{"@id":"epcis:SensorMetadata"},"rdfs:comment":{"@language":"en","@value":"Represents nominal values and specification limits (LSL, USL) for a particular parameter."},"rdfs:isDefinedBy":"rail:"},{"@id":"rail:DynamicCoefficient","@type":["owl:Class","rdf:Class"],"rdfs:comment":{"@language":"en","@value":"A set of dynamic Coefficient details (normalized axle number, left and right value) of the vehicle."},"rdfs:isDefinedBy":"rail:","rdfs:domain":{"@id":"epcis:SensorMetadata"},"rdfs:label":"Dynamic Coefficient Details","sw:term_status":"deprecated"},{"@id":"rail:typeWtms-WILD","@type":"rail:TypesWTMS","rdfs:label":"Wheel impact load detection","rdfs:comment":{"@language":"en","@value":"Indicates the type of WTMS installation to be a wheel impact load detection measurement station by Voestalpine."},"rdfs:isDefinedBy":"rail:","sw:term_status":"stable"},{"@id":"rail:railRunDistance","@type":"gs1:MeasurementType","rdfs:label":"Run Distance","rdfs:isDefinedBy":"rail:","rdfs:comment":{"@language":"en","@value":"It is the distance a rail vehicle has run in total from a point in time set in the past."},"sw:term_status":"stable"}]}
