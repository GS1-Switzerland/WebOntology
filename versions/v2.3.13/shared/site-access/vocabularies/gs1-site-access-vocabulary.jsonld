        "en": "restriction value",
        "de": "Beschränkungswert",
        "fr": "valeur de la restriction",
        "it": "valore della restrizione"
      },
      "comment": {
        "en": "Numeric limit as gs1:QuantitativeValue (gs1:value + gs1:unitCode, UN/CEFACT), e.g. 4.0 MTR. With mode Limited the value is a maximum.",
        "de": "Zahlenwert als gs1:QuantitativeValue (gs1:value + gs1:unitCode, UN/CEFACT), z. B. 4,0 MTR. Bei der Wirkungsweise „begrenzt“ ist der Wert ein Höchstwert.",
        "fr": "Limite numérique sous forme de gs1:QuantitativeValue (gs1:value + gs1:unitCode, UN/CEFACT), par ex. 4,0 MTR. Avec le mode « limité », la valeur est un maximum.",
        "it": "Limite numerico come gs1:QuantitativeValue (gs1:value + gs1:unitCode, UN/CEFACT), ad es. 4,0 MTR. Con la modalità «limitato» il valore è un massimo."
      },
      "domain": "gs1:AccessRestriction",
      "range": "gs1:QuantitativeValue",
      "isDefinedBy": "gs1:module/siteAccess",
      "termStatus": "unstable"
    },
    {
      "@id": "gs1:routeDescription",
      "@type": "owl:DatatypeProperty",
      "label": {
        "en": "route description",
        "de": "Routenbeschreibung",
        "fr": "description de l’itinéraire",
        "it": "descrizione del percorso"
      },
      "comment": {
        "en": "Route from the nearest major road or reference point.",
        "de": "Route von der nächsten Hauptstraße oder einem Bezugspunkt.",
        "fr": "Itinéraire depuis la route principale ou un point de repère le plus proche.",
        "it": "Percorso dalla strada principale o da un punto di riferimento più vicino."
      },
      "domain": "gs1:LocationGuidance",
      "range": "rdfs:Literal",
      "isDefinedBy": "gs1:module/siteAccess",
      "termStatus": "unstable"
    },
    {
