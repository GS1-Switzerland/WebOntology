      "@type": "owl:DatatypeProperty",
      "label": {
        "en": "signage description",
        "de": "Beschilderungshinweis",
        "fr": "description de la signalisation",
        "it": "descrizione della segnaletica"
      },
      "comment": {
        "en": "Signs, colours or numbers to follow.",
        "de": "Schilder, Farben oder Nummern, denen zu folgen ist.",
        "fr": "Panneaux, couleurs ou numéros à suivre.",
        "it": "Cartelli, colori o numeri da seguire."
      },
      "domain": "gs1:LocationGuidance",
      "range": "rdfs:Literal",
      "isDefinedBy": "gs1:module/siteAccess",
      "termStatus": "unstable"
    },
    {
      "@id": "gs1:slotDuration",
      "@type": "owl:DatatypeProperty",
      "label": {
        "en": "slot duration",
        "de": "Slotdauer",
        "fr": "durée du créneau",
        "it": "durata dello slot"
      },
      "comment": {
        "en": "Length of one bookable slot, ISO 8601 (PT30M).",
        "de": "Dauer eines buchbaren Slots, ISO 8601 (PT30M).",
        "fr": "Durée d’un créneau réservable, ISO 8601 (PT30M).",
        "it": "Durata di uno slot prenotabile, ISO 8601 (PT30M)."
      },
      "domain": "gs1:AccessTimeWindow",
      "range": "xsd:duration",
      "isDefinedBy": "gs1:module/siteAccess",
      "termStatus": "unstable"
    },
    {
      "@id": "gs1:timeWindowDescription",
      "@type": "owl:DatatypeProperty",
      "label": {
        "en": "time window description",
        "de": "Beschreibung des Zeitfensters",
        "fr": "description de la plage horaire",
        "it": "descrizione della fascia oraria"
      },
      "comment": {
        "en": "Explanation, e.g. reason for a closure.",
        "de": "Erläuterung, z. B. der Grund einer Schließung.",
        "fr": "Explication, par ex. motif d’une fermeture.",
        "it": "Spiegazione, ad es. il motivo di una chiusura."
      },
      "domain": "gs1:AccessTimeWindow",
      "range": "rdfs:Literal",
      "isDefinedBy": "gs1:module/siteAccess",
      "termStatus": "unstable"
    },
    {
      "@id": "gs1:timeWindowType",
      "@type": "owl:ObjectProperty",
      "label": {
        "en": "time window type",
        "de": "Art des Zeitfensters",
        "fr": "type de plage horaire",
        "it": "tipo di fascia oraria"
      },
      "comment": {
        "en": "Purpose of the window.",
        "de": "Zweck des Zeitfensters.",
        "fr": "Finalité de la plage horaire.",
        "it": "Scopo della fascia oraria."
      },
