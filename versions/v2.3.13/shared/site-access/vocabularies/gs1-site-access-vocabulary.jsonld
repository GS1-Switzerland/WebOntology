        "en": "Visitor",
        "de": "Besucher",
        "fr": "Visiteur",
        "it": "Visitatore"
      },
      "comment": {
        "en": "Person entering on foot or by passenger vehicle who is none of the other roles: guests, meeting attendees, auditors.",
