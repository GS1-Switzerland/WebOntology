    {
      "@id": "sai:SiteAccessElement",
      "@type": "owl:Class",
      "label": {
        "en": "Site Access Element",
        "de": "Zugangselement",
        "fr": "Élément d’accès",
        "it": "Elemento di accesso"
      },
      "comment": {
        "en": "Abstract superclass of statement-level elements. Carries cross-cutting qualifiers addressedTo, appliesToAccessPoint, applicableVehicleType, isMandatory. The same qualifiers are used on gs1:Place (access points) and gs1:ContactPoint.",
        "de": "Abstrakte Oberklasse der Aussageelemente. Trägt die übergreifenden Qualifizierer addressedTo, appliesToAccessPoint, applicableVehicleType und isMandatory. Dieselben Qualifizierer werden an gs1:Place (Zugangspunkten) und gs1:ContactPoint verwendet.",
        "fr": "Superclasse abstraite des éléments d’énoncé. Porte les qualificatifs transversaux addressedTo, appliesToAccessPoint, applicableVehicleType et isMandatory. Les mêmes qualificatifs sont utilisés sur gs1:Place (points d’accès) et gs1:ContactPoint.",
        "it": "Superclasse astratta degli elementi di affermazione. Porta i qualificatori trasversali addressedTo, appliesToAccessPoint, applicableVehicleType e isMandatory. Gli stessi qualificatori si usano su gs1:Place (punti di accesso) e gs1:ContactPoint."
      },
      "subClassOf": "schema:Thing",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:SiteAccessInformation",
      "@type": "owl:Class",
      "label": {
        "en": "Site Access Information",
        "de": "Standortzugangsinformation",
        "fr": "Informations d’accès au site",
        "it": "Informazioni di accesso al sito"
      },
      "comment": {
        "en": "Root node of a site access / logistics information document for one site (gs1:Place). Aggregates access instructions, restrictions, access times, registration requirements and location guidance; contacts and access points hang on the gs1:Place itself (gs1:contactPoint, gs1:containsPlace). Inherits schema:CreativeWork metadata (inLanguage, dateModified, version).",
        "de": "Wurzelknoten eines Dokuments mit Zugangs- und Logistikinformationen für einen Standort (gs1:Place). Bündelt Zugangsanweisungen, Beschränkungen, Zeitfenster, Registrierungsanforderungen und Ortshinweise; Kontakte und Zugangspunkte hängen am gs1:Place selbst (gs1:contactPoint, gs1:containsPlace). Erbt die Metadaten von schema:CreativeWork (inLanguage, dateModified, version).",
        "fr": "Nœud racine d’un document d’informations d’accès et de logistique pour un site (gs1:Place). Regroupe les instructions d’accès, restrictions, plages horaires, exigences d’enregistrement et indications de localisation ; les contacts et points d’accès se rattachent au gs1:Place lui-même (gs1:contactPoint, gs1:containsPlace). Hérite des métadonnées de schema:CreativeWork (inLanguage, dateModified, version).",
        "it": "Nodo radice di un documento con informazioni di accesso e logistica per un sito (gs1:Place). Riunisce istruzioni di accesso, restrizioni, fasce orarie, requisiti di registrazione e indicazioni di localizzazione; contatti e punti di accesso sono collegati al gs1:Place stesso (gs1:contactPoint, gs1:containsPlace). Eredita i metadati di schema:CreativeWork (inLanguage, dateModified, version)."
      },
      "subClassOf": "schema:CreativeWork",
      "usedWithLinkType": [
        "gs1:logisticsInfo",
        "gs1:scheduleTime",
        "gs1:siteAccessInstructions",
        "gs1:siteAccessRequirements"
      ],
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
