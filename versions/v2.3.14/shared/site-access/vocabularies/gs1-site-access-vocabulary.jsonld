        "en": "Warehouse Manager Contact",
        "de": "Lagerleiter",
        "fr": "Responsable d’entrepôt",
        "it": "Responsabile di magazzino"
      },
      "comment": {
        "en": "Warehouse or shift manager who can decide on the spot.",
        "de": "Lager- oder Schichtleiter, der vor Ort entscheiden kann.",
        "fr": "Responsable d’entrepôt ou chef d’équipe pouvant décider sur place.",
        "it": "Responsabile di magazzino o di turno che può decidere sul posto."
      },
      "inScheme": "gs1:ContactRoleTypeScheme",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:ContactUseCaseCode-ACCESS_PROBLEM",
      "@type": [
        "sai:ContactUseCaseCode",
        "skos:Concept"
      ],
      "label": {
        "en": "Access Problem",
        "de": "Zutritt verweigert",
        "fr": "Problème d’accès",
        "it": "Problema di accesso"
      },
      "comment": {
        "en": "Use when access is refused or credentials are not accepted.",
        "de": "Verwenden, wenn der Zutritt verweigert wird oder Nachweise nicht akzeptiert werden.",
        "fr": "À utiliser lorsque l’accès est refusé ou que les justificatifs ne sont pas acceptés.",
        "it": "Da usare quando l’accesso viene negato o i documenti non sono accettati."
      },
      "inScheme": "sai:ContactUseCaseCodeScheme",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
    {
      "@id": "sai:ContactUseCaseCode-CHANGE_OR_CANCEL_SLOT",
      "@type": [
        "sai:ContactUseCaseCode",
        "skos:Concept"
      ],
      "label": {
