# ======================================================================
# 4. NEW PROPERTIES
# ======================================================================

sai:describesSite a owl:ObjectProperty ;
    rdfs:label "describes site"@en ;
    rdfs:comment "The site (a gs1:Place, typically with a GLN) described by the document. If WebVoc gs1:location is confirmed to fit this domain it can replace this term."@en ;
    rdfs:domain sai:SiteAccessInformation ;
    rdfs:range gs1:Place ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:hasAccessInstruction a owl:ObjectProperty ;
    rdfs:label "has access instruction"@en ;
    rdfs:comment "An access instruction."@en ;
    rdfs:domain sai:SiteAccessInformation ;
    rdfs:range sai:AccessInstruction ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:hasAccessRestriction a owl:ObjectProperty ;
    rdfs:label "has access restriction"@en ;
    rdfs:comment "An access restriction."@en ;
    rdfs:domain sai:SiteAccessInformation ;
    rdfs:range sai:AccessRestriction ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:hasAccessTime a owl:ObjectProperty ;
    rdfs:label "has access time"@en ;
    rdfs:comment "An access time window."@en ;
    rdfs:domain sai:SiteAccessInformation ;
    rdfs:range sai:AccessTimeWindow ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:hasRegistrationRequirement a owl:ObjectProperty ;
    rdfs:label "has registration requirement"@en ;
    rdfs:comment "A registration requirement."@en ;
    rdfs:domain sai:SiteAccessInformation ;
    rdfs:range sai:RegistrationRequirement ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:hasLocationGuidance a owl:ObjectProperty ;
    rdfs:label "has location guidance"@en ;
    rdfs:comment "A piece of location guidance."@en ;
    rdfs:domain sai:SiteAccessInformation ;
    rdfs:range sai:LocationGuidance ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:hasSiteFacility a owl:ObjectProperty ;
    rdfs:label "has site facility"@en ;
    rdfs:comment "A facility available at the place or access point."@en ;
    rdfs:domain gs1:Place ;
    rdfs:range sai:SiteFacilityTypeCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:addressedTo a owl:ObjectProperty ;
    rdfs:label "addressed to"@en ;
    rdfs:comment "Role(s) for which a statement is relevant. Use on any sai:SiteAccessElement, on a gs1:Place used as access point, or on a gs1:ContactPoint. Absence means sai:SiteAccessRoleCode-ANY."@en ;
    rdfs:range sai:SiteAccessRoleCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:appliesToAccessPoint a owl:ObjectProperty ;
    rdfs:label "applies to access point"@en ;
    rdfs:comment "Restricts the statement to a specific access point (a gs1:Place). Absence means the whole site."@en ;
    rdfs:range gs1:Place ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:applicableVehicleType a owl:ObjectProperty ;
    rdfs:label "applicable vehicle type"@en ;
    rdfs:comment "Vehicle type(s) for which the statement is relevant."@en ;
    rdfs:range sai:VehicleTypeCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:isMandatory a owl:DatatypeProperty ;
    rdfs:label "is mandatory"@en ;
    rdfs:comment "True if compliance is compulsory."@en ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:timeZone a owl:DatatypeProperty ;
    rdfs:label "time zone"@en ;
    rdfs:comment "IANA time zone (e.g. Europe/Berlin) in which schema:opens/closes and dates are interpreted. On sai:SiteAccessInformation (document default) or sai:AccessTimeWindow (override)."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:instructionText a owl:DatatypeProperty ;
    rdfs:label "instruction text"@en ;
    rdfs:comment "Instruction text; language map in JSON-LD."@en ;
    rdfs:domain sai:AccessInstruction ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:instructionType a owl:ObjectProperty ;
    rdfs:label "instruction type"@en ;
    rdfs:comment "Kind of procedure."@en ;
    rdfs:domain sai:AccessInstruction ;
    rdfs:range sai:SiteInstructionTypeCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:restrictionType a owl:ObjectProperty ;
    rdfs:label "restriction type"@en ;
    rdfs:comment "Subject of the restriction."@en ;
    rdfs:domain sai:AccessRestriction ;
    rdfs:range sai:AccessRestrictionTypeCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:restrictionMode a owl:ObjectProperty ;
    rdfs:label "restriction mode"@en ;
    rdfs:comment "Prohibited, required, limited or advisory."@en ;
    rdfs:domain sai:AccessRestriction ;
    rdfs:range sai:AccessRestrictionModeCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:restrictionValue a owl:ObjectProperty ;
    rdfs:label "restriction value"@en ;
    rdfs:comment "Numeric limit as gs1:QuantitativeValue (gs1:value + gs1:unitCode, UN/CEFACT), e.g. 4.0 MTR. With mode Limited the value is a maximum."@en ;
    rdfs:domain sai:AccessRestriction ;
    rdfs:range gs1:QuantitativeValue ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:restrictionText a owl:DatatypeProperty ;
    rdfs:label "restriction text"@en ;
    rdfs:comment "Human-readable statement of the restriction."@en ;
    rdfs:domain sai:AccessRestriction ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:requiredEquipment a owl:ObjectProperty ;
    rdfs:label "required equipment"@en ;
    rdfs:comment "Equipment required. On a sai:AccessRestriction: what people must wear or carry. On a sai:HandoverRequirement: what the vehicle or driver must bring (tail lift, pallet jack)."@en ;
    rdfs:range sai:RequiredEquipmentTypeCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:timeWindowType a owl:ObjectProperty ;
    rdfs:label "time window type"@en ;
    rdfs:comment "Purpose of the window."@en ;
    rdfs:domain sai:AccessTimeWindow ;
    rdfs:range sai:AccessTimeWindowTypeCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:timeWindowDescription a owl:DatatypeProperty ;
    rdfs:label "time window description"@en ;
    rdfs:comment "Explanation, e.g. reason for a closure."@en ;
    rdfs:domain sai:AccessTimeWindow ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:requiresAppointment a owl:DatatypeProperty ;
    rdfs:label "requires appointment"@en ;
    rdfs:comment "Access in this window needs a booked appointment or slot."@en ;
    rdfs:domain sai:AccessTimeWindow ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:slotDuration a owl:DatatypeProperty ;
    rdfs:label "slot duration"@en ;
    rdfs:comment "Length of one bookable slot, ISO 8601 (PT30M)."@en ;
    rdfs:domain sai:AccessTimeWindow ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:arrivalTolerance a owl:DatatypeProperty ;
    rdfs:label "arrival tolerance"@en ;
    rdfs:comment "Accepted deviation from slot start, ISO 8601 (PT15M)."@en ;
    rdfs:domain sai:AccessTimeWindow ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:maxVehiclesPerSlot a owl:DatatypeProperty ;
    rdfs:label "max vehicles per slot"@en ;
    rdfs:comment "Maximum vehicles per slot."@en ;
    rdfs:domain sai:AccessTimeWindow ;
    rdfs:range xsd:positiveInteger ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:registrationMethod a owl:ObjectProperty ;
    rdfs:label "registration method"@en ;
    rdfs:comment "How registration or booking is done."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range sai:RegistrationMethodCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:registrationUrl a owl:DatatypeProperty ;
    rdfs:label "registration url"@en ;
    rdfs:comment "Web address of the registration or booking facility."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:registrationText a owl:DatatypeProperty ;
