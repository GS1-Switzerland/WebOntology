    rdfs:comment "Personal protective equipment (see requiredEquipment)."@en ;
    skos:inScheme sai:AccessRestrictionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCode-PROHIBITED_ITEMS a sai:AccessRestrictionTypeCode , skos:Concept ;
