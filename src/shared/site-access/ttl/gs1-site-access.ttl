sai:SiteInstructionTypeCode-DEPARTURE_PROCEDURE a sai:SiteInstructionTypeCode , skos:Concept ;
    rdfs:label "Departure Procedure"@en ;
    rdfs:comment "Check-out and leaving."@en ;
    skos:inScheme sai:SiteInstructionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteInstructionTypeCode-SAFETY_BRIEFING a sai:SiteInstructionTypeCode , skos:Concept ;
    rdfs:label "Safety Briefing"@en ;
    rdfs:comment "Site rules and safety information."@en ;
    skos:inScheme sai:SiteInstructionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteInstructionTypeCode-EMERGENCY_PROCEDURE a sai:SiteInstructionTypeCode , skos:Concept ;
    rdfs:label "Emergency Procedure"@en ;
    rdfs:comment "Evacuation and incident reporting."@en ;
    skos:inScheme sai:SiteInstructionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteInstructionTypeCode-OUT_OF_HOURS_PROCEDURE a sai:SiteInstructionTypeCode , skos:Concept ;
    rdfs:label "Out Of Hours Procedure"@en ;
    rdfs:comment "Procedure outside normal hours, e.g. key safe or call-in."@en ;
    skos:inScheme sai:SiteInstructionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteInstructionTypeCode-HANDOVER_PROCEDURE a sai:SiteInstructionTypeCode , skos:Concept ;
    rdfs:label "Handover Procedure"@en ;
    rdfs:comment "Handing over the goods: who receives, where and in which order."@en ;
    skos:inScheme sai:SiteInstructionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCode a owl:Class ;
    rdfs:label "Access Restriction Type Code"@en ;
    rdfs:comment "The subject matter of an access restriction. Code list in WebVoc style: members are sai:AccessRestrictionTypeCode-MEMBER_NAME and skos:Concepts."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCodeScheme a skos:ConceptScheme ;
