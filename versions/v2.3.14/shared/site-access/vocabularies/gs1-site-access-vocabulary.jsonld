        "it": "Da usare in caso di problemi durante lo scarico o la consegna."
      },
      "inScheme": "sai:ContactUseCaseCodeScheme",
      "isDefinedBy": "https://ref.gs1.org/sai/",
      "termStatus": "unstable"
    },
