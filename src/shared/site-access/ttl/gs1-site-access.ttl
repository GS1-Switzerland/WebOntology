sai:SiteInstructionTypeCode-PARKING_PROCEDURE a sai:SiteInstructionTypeCode , skos:Concept ;
    rdfs:label "Parking Procedure"@en ;
    rdfs:comment "Where and how to park or wait."@en ;
    skos:inScheme sai:SiteInstructionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
