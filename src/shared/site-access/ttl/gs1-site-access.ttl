    rdfs:comment "Explanation of the registration process."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:advanceNotice a owl:DatatypeProperty ;
    rdfs:label "advance notice"@en ;
    rdfs:comment "Minimum lead time before arrival, ISO 8601 (PT24H)."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:requiredCredential a owl:ObjectProperty ;
    rdfs:label "required credential"@en ;
    rdfs:comment "Information or document to present."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range sai:RegistrationCredentialTypeCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:inductionValidity a owl:DatatypeProperty ;
    rdfs:label "induction validity"@en ;
    rdfs:comment "How long a completed induction or registration stays valid (P365D)."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:registrationContact a owl:ObjectProperty ;
    rdfs:label "registration contact"@en ;
    rdfs:comment "Contact for registration questions."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range gs1:ContactPoint ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:navigationAddress a owl:ObjectProperty ;
    rdfs:label "navigation address"@en ;
    rdfs:comment "Address to enter in a navigation system when it differs from the registered address."@en ;
    rdfs:domain sai:LocationGuidance ;
    rdfs:range gs1:PostalAddress ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:routeDescription a owl:DatatypeProperty ;
    rdfs:label "route description"@en ;
    rdfs:comment "Route from the nearest major road or reference point."@en ;
    rdfs:domain sai:LocationGuidance ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:signageDescription a owl:DatatypeProperty ;
    rdfs:label "signage description"@en ;
    rdfs:comment "Signs, colours or numbers to follow."@en ;
    rdfs:domain sai:LocationGuidance ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:navigationWarning a owl:DatatypeProperty ;
    rdfs:label "navigation warning"@en ;
    rdfs:comment "Known pitfall, e.g. satnav sends trucks to the wrong gate, low bridge."@en ;
    rdfs:domain sai:LocationGuidance ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .


# ======================================================================
# 4b. PROPERTIES ADDED IN 0.3.0
# ======================================================================

sai:buildingName a owl:DatatypeProperty ;
    rdfs:label "building name"@en ;
    rdfs:comment "Name or number of the building (for multi-building sites and business parks)."@en ;
    rdfs:domain gs1:Place ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:floorLevel a owl:DatatypeProperty ;
    rdfs:label "floor level"@en ;
    rdfs:comment "Floor or level as shown in the building, e.g. 3, EG, -1."@en ;
    rdfs:domain gs1:Place ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:unitIdentifier a owl:DatatypeProperty ;
    rdfs:label "unit identifier"@en ;
    rdfs:comment "Unit, suite, office or room number of the recipient within the site."@en ;
    rdfs:domain gs1:Place ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:signLabel a owl:DatatypeProperty ;
    rdfs:label "sign label"@en ;
    rdfs:comment "Text exactly as shown on signs at this place, e.g. Tor 4, Rampe West."@en ;
    rdfs:domain gs1:Place ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:basedOn a owl:ObjectProperty ;
    rdfs:label "based on"@en ;
    rdfs:comment "Company-wide default document this site document builds on. Categories the site document leaves empty are taken from the base document."@en ;
    rdfs:domain sai:SiteAccessInformation ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:hasHandoverRequirement a owl:ObjectProperty ;
    rdfs:label "has handover requirement"@en ;
    rdfs:comment "A handover requirement."@en ;
    rdfs:domain sai:SiteAccessInformation ;
    rdfs:range sai:HandoverRequirement ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:appliesToGoodsType a owl:ObjectProperty ;
    rdfs:label "applies to goods type"@en ;
    rdfs:comment "Restricts the statement to a kind of goods, e.g. parcels accepted only until 12:00."@en ;
    rdfs:range sai:GoodsTypeCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:closureReason a owl:ObjectProperty ;
    rdfs:label "closure reason"@en ;
    rdfs:comment "Why the site or goods-in is closed in this window."@en ;
    rdfs:domain sai:AccessTimeWindow ;
    rdfs:range sai:ClosureReasonCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:recurrence a owl:ObjectProperty ;
    rdfs:label "recurrence"@en ;
    rdfs:comment "Whether a dated window repeats every year (Annually) or applies once."@en ;
    rdfs:domain sai:AccessTimeWindow ;
    rdfs:range sai:RecurrenceCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:useWhen a owl:ObjectProperty ;
    rdfs:label "use when"@en ;
    rdfs:comment "Situation in which this contact should be used."@en ;
    rdfs:domain gs1:ContactPoint ;
    rdfs:range sai:ContactUseCaseCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:telephoneType a owl:ObjectProperty ;
    rdfs:label "telephone type"@en ;
    rdfs:comment "Kind of number given in gs1:telephone: switchboard, direct dial or mobile."@en ;
    rdfs:domain gs1:ContactPoint ;
    rdfs:range sai:TelephoneTypeCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:contactPriority a owl:DatatypeProperty ;
    rdfs:label "contact priority"@en ;
    rdfs:comment "Order in which to try contacts for the same situation; 1 = first."@en ;
    rdfs:domain gs1:ContactPoint ;
    rdfs:range xsd:positiveInteger ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:registrationPoint a owl:ObjectProperty ;
    rdfs:label "registration point"@en ;
    rdfs:comment "The access point (gate, gatehouse, reception) where registration or sign-in takes place."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range gs1:Place ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:idDocumentHandling a owl:ObjectProperty ;
    rdfs:label "id document handling"@en ;
    rdfs:comment "Whether an identity document is shown, copied or deposited at sign-in."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range sai:IdDocumentHandlingCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:inductionMode a owl:ObjectProperty ;
    rdfs:label "induction mode"@en ;
    rdfs:comment "How the safety induction is done, e.g. online before arrival."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range sai:SafetyInductionModeCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:inductionUrl a owl:DatatypeProperty ;
    rdfs:label "induction url"@en ;
    rdfs:comment "Web address of the online safety induction."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:inductionDuration a owl:DatatypeProperty ;
    rdfs:label "induction duration"@en ;
    rdfs:comment "How long the induction takes, ISO 8601 (PT10M)."@en ;
    rdfs:domain sai:RegistrationRequirement ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:handoverMethod a owl:ObjectProperty ;
    rdfs:label "handover method"@en ;
    rdfs:comment "How and to whom the goods are handed over."@en ;
    rdfs:domain sai:HandoverRequirement ;
    rdfs:range sai:HandoverMethodCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:handoverPoint a owl:ObjectProperty ;
    rdfs:label "handover point"@en ;
    rdfs:comment "The place of handover (a gs1:Place with building, floor, unit and role DELIVERY_POINT)."@en ;
    rdfs:domain sai:HandoverRequirement ;
    rdfs:range gs1:Place ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:personsRequired a owl:DatatypeProperty ;
    rdfs:label "persons required"@en ;
    rdfs:comment "Number of people needed for delivery, e.g. 2 for two-person delivery."@en ;
    rdfs:domain sai:HandoverRequirement ;
    rdfs:range xsd:positiveInteger ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:siteUnloadingEquipment a owl:ObjectProperty ;
    rdfs:label "site unloading equipment"@en ;
    rdfs:comment "Equipment the site offers for unloading (ramp, forklift, goods lift) or NoUnloadingAids."@en ;
    rdfs:domain sai:HandoverRequirement ;
    rdfs:range sai:UnloadingEquipmentCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:requiredProofOfDelivery a owl:ObjectProperty ;
    rdfs:label "required proof of delivery"@en ;
    rdfs:comment "Evidence of delivery the driver must capture."@en ;
    rdfs:domain sai:HandoverRequirement ;
    rdfs:range sai:ProofOfDeliveryCode ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:handoverText a owl:DatatypeProperty ;
    rdfs:label "handover text"@en ;
    rdfs:comment "Explanation of the handover in words."@en ;
    rdfs:domain sai:HandoverRequirement ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:glnExtension a owl:DatatypeProperty ;
    rdfs:label "gln extension"@en ;
    rdfs:comment "GLN extension component (GS1 Application Identifier 254): up to 20 characters that identify a sub-location (dock door, floor, room, bay) together with the GLN of the site, or of the building above it, that carries the extension. GS1 Digital Link form: /414/{GLN}/254/{extension}. Extension plus GLN identify the place; the extension alone does not."@en ;
    rdfs:domain gs1:Place ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .
