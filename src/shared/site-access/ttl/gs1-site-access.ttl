@prefix gs1:    <https://ref.gs1.org/voc/> .
@prefix sai:    <https://ref.gs1.org/sai/> .
@prefix schema: <http://schema.org/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix sw:     <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

<https://ref.gs1.org/sai/> a owl:Ontology ;
    dct:title "GS1 Site Access and Logistics Information Module (sai)"@en ;
    dct:description "Terms for describing how a physical site (GLN-identified gs1:Place) can be found and accessed by visitors, delivery drivers, suppliers, contractors and employees: access points, instructions, restrictions, access times, registration and contacts. Payload vocabulary for the GS1 Digital Link link types gs1:siteAccessInstructions (see note on gs1:siteAccessRequirements), gs1:logisticsInfo and gs1:scheduleTime. GS1 WebVoc terms are re-used first (gs1:Place, gs1:containsPlace, gs1:locationRole, gs1:ContactPoint, gs1:contactRoleCode, gs1:PostalAddress, gs1:GeoCoordinates, gs1:QuantitativeValue, gs1:referencedFile ...), then schema.org; only gaps are defined as new terms. Terms defined by this module use the prefix sai: (https://ref.gs1.org/sai/); re-used GS1 WebVoc terms keep gs1:. All sai: terms are PROPOSED and can be moved into the GS1 Web Vocabulary."@en ;
    owl:versionInfo "0.2.0-draft" ;
    dct:created "2026-11-19"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:seeAlso <https://ref.gs1.org/voc/> , <http://schema.org/> .

sai:usedWithLinkType a owl:AnnotationProperty ;
    rdfs:label "used with link type"@en ;
    rdfs:comment "Annotates a class: the GS1 Digital Link link type(s) under which instances of the class are expected to be published. gs1:siteAccessRequirements exists in the current WebVoc core context; gs1:siteAccessInstructions is the link type named in the requirement - both are listed until the final name is confirmed."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ; sw:term_status "unstable" .


# ======================================================================
# 1. NEW CLASSES (gaps only; Place, ContactPoint, PostalAddress, GeoCoordinates, QuantitativeValue, ReferencedFileDetails are re-used from WebVoc)
# ======================================================================

sai:SiteAccessInformation a owl:Class ;
    rdfs:label "Site Access Information"@en ;
    rdfs:comment "Root node of a site access / logistics information document for one site (gs1:Place). Aggregates access instructions, restrictions, access times, registration requirements and location guidance; contacts and access points hang on the gs1:Place itself (gs1:contactPoint, gs1:containsPlace). Inherits schema:CreativeWork metadata (inLanguage, dateModified, version)."@en ;
    rdfs:subClassOf schema:CreativeWork ;
    sai:usedWithLinkType gs1:siteAccessInstructions , gs1:siteAccessRequirements , gs1:logisticsInfo , gs1:scheduleTime ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteAccessElement a owl:Class ;
    rdfs:label "Site Access Element"@en ;
    rdfs:comment "Abstract superclass of statement-level elements. Carries cross-cutting qualifiers addressedTo, appliesToAccessPoint, applicableVehicleType, isMandatory. The same qualifiers are used on gs1:Place (access points) and gs1:ContactPoint."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessInstruction a owl:Class ;
    rdfs:label "Access Instruction"@en ;
    rdfs:comment "A practical instruction: arrive, check in, park, load/unload, depart, emergency. Order steps with schema:position."@en ;
    rdfs:subClassOf sai:SiteAccessElement ;
    sai:usedWithLinkType gs1:siteAccessInstructions , gs1:siteAccessRequirements , gs1:logisticsInfo ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestriction a owl:Class ;
    rdfs:label "Access Restriction"@en ;
    rdfs:comment "A prohibition, requirement, limit or advisory for entering or operating at the site. Machine-evaluable via restrictionType + restrictionMode + restrictionValue."@en ;
    rdfs:subClassOf sai:SiteAccessElement ;
    sai:usedWithLinkType gs1:siteAccessInstructions , gs1:siteAccessRequirements , gs1:logisticsInfo ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessTimeWindow a owl:Class ;
    rdfs:label "Access Time Window"@en ;
    rdfs:comment "A recurring or dated time window in which access, visiting, delivery or collection is possible, restricted or closed. WebVoc has no opening-hours class (only the openingHoursInfo link type), so schema:OpeningHoursSpecification is specialised: schema:dayOfWeek, schema:opens, schema:closes and gs1:validFrom / gs1:validThrough (WebVoc, xsd:dateTime) are re-used."@en ;
    rdfs:subClassOf schema:OpeningHoursSpecification , sai:SiteAccessElement ;
    sai:usedWithLinkType gs1:scheduleTime , gs1:logisticsInfo , gs1:siteAccessInstructions , gs1:siteAccessRequirements ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:RegistrationRequirement a owl:Class ;
    rdfs:label "Registration Requirement"@en ;
    rdfs:comment "What must be arranged before or on arrival: book a slot, pre-register, present credentials, complete an induction."@en ;
    rdfs:subClassOf sai:SiteAccessElement ;
    sai:usedWithLinkType gs1:siteAccessInstructions , gs1:siteAccessRequirements , gs1:logisticsInfo ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:LocationGuidance a owl:Class ;
    rdfs:label "Location Guidance"@en ;
    rdfs:comment "Practical help to find the site or an access point: navigation address, route, signage, warnings. General descriptions use WebVoc gs1:locationDescription; maps use gs1:referencedFile."@en ;
    rdfs:subClassOf sai:SiteAccessElement ;
    sai:usedWithLinkType gs1:siteAccessInstructions , gs1:siteAccessRequirements , gs1:logisticsInfo ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:HandoverRequirement a owl:Class ;
    rdfs:label "Handover Requirement"@en ;
    rdfs:comment "The conditions of the final handover: who receives the goods and where, how many people and which equipment are needed, what the site offers for unloading and which proof of delivery must be captured. Answers the questions a driver otherwise discovers only at the dock."@en ;
    rdfs:subClassOf sai:SiteAccessElement ;
    sai:usedWithLinkType gs1:siteAccessInstructions , gs1:siteAccessRequirements , gs1:logisticsInfo ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .


# ======================================================================
# 2. NEW CODE LISTS
# ======================================================================

sai:SiteAccessRoleCode a owl:Class ;
    rdfs:label "Site Access Role Code"@en ;
    rdfs:comment "The audience (addressee) role a statement is meant for. Code list in WebVoc style: members are sai:SiteAccessRoleCode-MEMBER_NAME and skos:Concepts."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteAccessRoleCodeScheme a skos:ConceptScheme ;
    rdfs:label "Site Access Role Code Scheme"@en ;
    rdfs:comment "Concept scheme of sai:SiteAccessRoleCode."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteAccessRoleCode-VISITOR a sai:SiteAccessRoleCode , skos:Concept ;
    rdfs:label "Visitor"@en ;
    rdfs:comment "Person entering on foot or by passenger vehicle who is none of the other roles: guests, meeting attendees, auditors."@en ;
    skos:inScheme sai:SiteAccessRoleCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteAccessRoleCode-DELIVERY_DRIVER a sai:SiteAccessRoleCode , skos:Concept ;
    rdfs:label "Delivery Driver"@en ;
    rdfs:comment "Person operating a vehicle that delivers goods to, or collects goods from, the site (own fleet, carrier or courier)."@en ;
    skos:inScheme sai:SiteAccessRoleCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteAccessRoleCode-SUPPLIER a sai:SiteAccessRoleCode , skos:Concept ;
    rdfs:label "Supplier"@en ;
    rdfs:comment "Trading-partner organisation supplying goods or services to the site operator and its representatives (sales, quality, booking of deliveries). Often not the person who drives the truck."@en ;
    skos:inScheme sai:SiteAccessRoleCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteAccessRoleCode-CONTRACTOR a sai:SiteAccessRoleCode , skos:Concept ;
    rdfs:label "Contractor"@en ;
    rdfs:comment "External service provider or tradesperson working on site: maintenance, construction, cleaning, IT, security. Typically needs work authorisation and induction."@en ;
    skos:inScheme sai:SiteAccessRoleCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteAccessRoleCode-EMPLOYEE a sai:SiteAccessRoleCode , skos:Concept ;
    rdfs:label "Employee"@en ;
    rdfs:comment "Staff of the site operator or its group, incl. temporary staff, entering with their own access credential."@en ;
    skos:inScheme sai:SiteAccessRoleCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteAccessRoleCode-ANY a sai:SiteAccessRoleCode , skos:Concept ;
    rdfs:label "Any"@en ;
    rdfs:comment "Statement applies to every role; use instead of repeating it for each role."@en ;
    skos:inScheme sai:SiteAccessRoleCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteInstructionTypeCode a owl:Class ;
    rdfs:label "Site Instruction Type Code"@en ;
    rdfs:comment "The kind of procedure an access instruction describes. Code list in WebVoc style: members are sai:SiteInstructionTypeCode-MEMBER_NAME and skos:Concepts."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:SiteInstructionTypeCodeScheme a skos:ConceptScheme ;
