    rdfs:comment "Must be escorted."@en ;
    skos:inScheme sai:AccessRestrictionTypeCodeScheme ;
    rdfs:isDefinedBy <https://ref.gs1.org/sai/> ;
    sw:term_status "unstable" .

sai:AccessRestrictionTypeCode-PHOTOGRAPHY_RESTRICTION a sai:AccessRestrictionTypeCode , skos:Concept ;
