      "@type": [
        "sai:ContactUseCaseCode",
        "skos:Concept"
      ],
      "label": {
        "en": "Gate Closed",
        "de": "Tor geschlossen",
        "fr": "Portail fermé",
        "it": "Cancello chiuso"
      },
      "comment": {
        "en": "Use when the gate, barrier or roller door is closed or nobody answers.",
